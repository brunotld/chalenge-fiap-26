  <folder name="Motivation" id="id-7de64ed7881744f7a767353f861bb275" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Presidente da software house super soluções" id="id-8a1ec968b36041a699cbdcd2906fb383"/>
    <element xsi:type="archimate:Driver" name="Formalizar todo o atendimento de suporte " id="id-09f87d218c1640bbae89dd2617ae490c"/>
    <element xsi:type="archimate:Driver" name="conhecer o desempenho da equipe de suporte " id="id-9cae7ef00e804bb784a78cac65a21dea"/>
    <element xsi:type="archimate:Driver" name="conhecer o nivel de satisfação dos clientes " id="id-1ca0e7839a7c4d06a09b3e5ab362df2e"/>
    <element xsi:type="archimate:Principle" name="Principle" id="id-8ebe46df50434642980f060bbd449697"/>
    <element xsi:type="archimate:Principle" name="entre os indicadores de desempenho é obrigatoria a medição de ciclo de atendimento do registro à solução do chamado" id="id-ebba6200f1684a8cabbfb94e8689fda7"/>
    <element xsi:type="archimate:Principle" name="Coletar feedback de todos os clientes que abriram chamados tecnicos " id="id-33f4a78b4c554be2a3c25b8f64ba2e90"/>
    <element xsi:type="archimate:Principle" name="Registrar dados sobre cada demanda no suporte, permitindo a recuperação da informação e acompanhamento do atendimento " id="id-28cdd356bf6b4fad89c363b3e2f61d9e"/>
  </folder>
